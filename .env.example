# ==============================================================================
# OnePlay Subscription Tracker Configuration
# ==============================================================================

# Target plans: Haven HD (799), Haven 4K (1099), Enthusiast (1299), Prime (1599)
TARGET_PLANS="Haven HD, Haven 4K, Enthusiast, Prime, 799, 1099, 1299, 1599"

# Polling cadence & jitter (20-30s polling)
POLL_INTERVAL_SECONDS=25
POLL_JITTER_SECONDS=3

# Notification lifecycle behavior
# 1. Sends an immediate alert when plan is IN STOCK.
# 2. Sends exactly ONE backup alert after N seconds (e.g. 180s = 3 min), then stays completely silent.
SEND_BACKUP_NOTIFICATION=true
BACKUP_DELAY_SECONDS=180

# 3. Sends an immediate alert when plan sells OUT OF STOCK (so you know window closed).
NOTIFY_ON_OUT_OF_STOCK=true

# Cold startup behavior: if true, immediately alerts if already in stock on boot
ALERT_ON_STARTUP=false

# State persistence file (preserves state across container restarts)
STATE_FILE="state.json"

# ------------------------------------------------------------------------------
# Discord Webhook Notification Channel
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""

# Optional Telegram fallback
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

LOG_LEVEL="INFO"
